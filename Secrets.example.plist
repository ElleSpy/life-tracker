<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for TickTick (and future) API credentials.

  To enable TickTick sync:
  1. Copy this file to LifeTracker/Secrets.plist  (that path is git-ignored).
  2. Fill in the values from your TickTick developer app.
  See TICKTICK_SETUP.md for step-by-step instructions.
-->
<plist version="1.0">
<dict>
    <key>TickTickClientID</key>
    <string>YOUR_TICKTICK_CLIENT_ID</string>
    <key>TickTickClientSecret</key>
    <string>YOUR_TICKTICK_CLIENT_SECRET</string>
    <key>TickTickRedirectURI</key>
    <string>lifetracker://ticktick-auth</string>
</dict>
</plist>
